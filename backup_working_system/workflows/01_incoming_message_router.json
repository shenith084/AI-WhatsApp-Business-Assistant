    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Robust Classification Parser\nconst rawResponse = $input.item.json.output ?? $input.item.json.text ?? '';\nconst ctx = $('Build AI Context').item.json;\nconst msgText = (ctx.messageText || '').trim().toLowerCase();\n\nlet classification = null;\n\n// 1. Direct hardcoded check for common greetings\nconst greetings = ['hi', 'hello', 'hey', 'good morning', 'good evening', 'hii', 'hiii', 'yo', 'sup', 'whatsup', 'hi there', 'hello there'];\nif (greetings.includes(msgText)) {\n  classification = {\n    intent: 'GENERAL_QUESTION',\n    confidence: 1.0,\n    entities: {},\n    language: 'en'\n  };\n} else {\n  // 2. Try parsing ReAct or standard JSON output from Gemini\n  try {\n    let textToParse = rawResponse;\n    if (typeof rawResponse === 'string' && rawResponse.includes('\"action_input\"')) {\n      try {\n        const reactObj = JSON.parse(rawResponse);\n        textToParse = reactObj.action_input || rawResponse;\n      } catch(e) {}\n    }\n    \n    const cleaned = textToParse.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n    const jsonMatch = cleaned.match(/\\{[\\s\\S]*\\}/);\n    const jsonStr = jsonMatch ? jsonMatch[0] : cleaned;\n    classification = JSON.parse(jsonStr);\n  } catch (e) {\n    // If classification JSON parsing fails, treat as GENERAL_QUESTION with 1.0 confidence so it goes to AI response, NEVER human handoff\n    classification = {\n      intent: 'GENERAL_QUESTION',\n      confidence: 1.0,\n      entities: {},\n      language: 'en'\n    };\n  }\n}\n\nreturn [{\n  json: {\n    ...ctx,\n    intent:     classification.intent     || 'GENERAL_QUESTION',\n    confidence: classification.confidence ?? 1.0,\n    entities:   classification.entities   || {},\n    language:   classification.language   || 'en'\n  }\n}];",
        "notice": ""
      },
      "id": "45737873-8375-4e06-be4f-f05eb5822370",
      "name": "Parse Classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -4640,
        32
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst contextMessages = $input.all();\nconst businessData    = $('Get Business by Session').item.json;\nconst normalized      = $('Normalize Payload').item.json;\nconst customerState   = $('Get Customer State').item?.json?.active_flow || 'NONE';\n\nconst historyLines = contextMessages\n  .slice(0, 10)\n  .map(m => `[${m.json.direction.toUpperCase()}]: ${m.json.message_text}`)\n  .join('\\n');\n\nreturn [{\n  json: {\n    business_id:   businessData.business_id,\n    business_name: businessData.business_name,\n    admin_phone:   businessData.admin_phone,\n    phoneNumber:   normalized.phoneNumber,\n    chatId:        normalized.chatId,\n    messageText:   normalized.messageText,\n    active_flow:   customerState,\n    contextHistory: historyLines || '(no prior conversation)',\n    prompt: `Business: ${businessData.business_name}\\nCustomer State: ${customerState}\\n\\nConversation history (most recent first):\\n${historyLines || '(no prior conversation)'}\\n\\nCustomer message: ${normalized.messageText}`\n  }\n}];\n",
        "notice": ""
      },
      "id": "7dc48fd0-ef60-49f5-8fc0-9ee4be087001",
      "name": "Build AI Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
