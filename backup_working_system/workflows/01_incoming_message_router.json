      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "UPDATE conversations\nSET detected_intent = '{{ $json.intent }}', confidence = {{ $json.confidence || 0 }}\nWHERE business_id = '{{ $(\"Get Business by Session\").first().json.business_id }}' AND customer_number = '{{ $(\"Normalize Payload\").first().json.phoneNumber }}'\n  AND created_at = (SELECT MAX(created_at) FROM conversations WHERE business_id = '{{ $(\"Get Business by Session\").first().json.business_id }}' AND customer_number = '{{ $(\"Normalize Payload\").first().json.phoneNumber }}');",
        "options": {}
      },
      "id": "d77c5603-382c-4b86-b8f7-3105a7cad0ab",
      "name": "Update Conversation Intent",
      "type": "n8n-nodes-base.postgres",
