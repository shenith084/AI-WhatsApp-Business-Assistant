    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body ?? $input.item.json;\n\n// Ignore messages sent by the bot itself\nif (body.payload?.fromMe === true) {\n  return [{ json: { skip: true } }];\n}\n\n// Extract fields\nconst event       = body.event ?? 'message';\nconst sessionName = body.session ?? '';\nconst payload     = body.payload ?? {};\n\nconst fromRaw     = payload.from ?? '';\nconst chatId      = payload.from ?? '';\nconst phoneNumber = fromRaw.replace('@c.us', '').replace('@g.us', '');\nconst messageText = payload.body ?? payload.text ?? '';\nconst timestamp   = payload.timestamp ? new Date(payload.timestamp * 1000).toISOString() : new Date().toISOString();\nconst messageId   = payload.id ? String(payload.id) : `fallback_${timestamp}`;\n\nif (!messageText.trim()) {\n  return [{ json: { skip: true, reason: 'no_text' } }];\n}\n\nreturn [{\n  json: {\n    skip: false,\n    sessionName,\n    phoneNumber,\n    chatId,\n    messageText,\n    messageId,\n    timestamp,\n    event\n  }\n}];"
      },
      "id": "c184e8a6-a734-4a06-8a75-83b45ae9c2f6",
      "name": "Normalize Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2736,
        400
      ],
      "notes": "Extracts phone, chatId, messageText from WAHA payload. Returns skip=true for bot's own outgoing messages."
    },
