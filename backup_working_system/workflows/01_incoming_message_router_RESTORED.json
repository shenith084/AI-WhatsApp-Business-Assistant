        240,
        304
      ],
      "webhookId": "waha-inbound-webhook",
      "notes": "WAHA posts inbound message events here. Set this URL in WAHA session config: PUT /api/sessions/fashion-gallery with webhooks[0].url = this URL and events: ['message']. Also set hmac.key for signature verification."
    },
    {
      "parameters": {
