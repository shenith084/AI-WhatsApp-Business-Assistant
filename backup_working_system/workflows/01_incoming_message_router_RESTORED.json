        "operation": "executeQuery",
        "query": "SELECT direction, message_text, detected_intent, created_at FROM conversations WHERE business_id = '{{ $(\"Get Business by Session\").first().json.business_id }}' AND customer_number = '{{ $(\"Normalize Payload\").first().json.phoneNumber }}' ORDER BY created_at DESC LIMIT 5;",
        "options": {}
