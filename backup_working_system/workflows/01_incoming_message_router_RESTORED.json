    {
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "INSERT INTO conversations (business_id, customer_number, direction, message_text, waha_message_id)\nVALUES (\n  '{{ $json.business_id }}',\n  '{{ $(\"Normalize Payload\").first().json.phoneNumber }}',\n  'inbound',\n  '{{ $(\"Normalize Payload\").first().json.messageText.replace(/'/g, \"''\") }}',\n  '{{ $(\"Normalize Payload\").first().json.messageId }}'\n)\nRETURNING id AS conversation_id;",
