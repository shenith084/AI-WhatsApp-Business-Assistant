      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "SELECT id AS business_id, business_name, owner_name, whatsapp_number\nFROM businesses\nWHERE waha_session = '{{ $(\"Normalize Payload\").first().json.sessionName }}' AND status = 'active'\nLIMIT 1;",
