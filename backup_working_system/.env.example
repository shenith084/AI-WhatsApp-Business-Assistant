# ─────────────────────────────────────────────────────────────────────────────
# AI WhatsApp Business Assistant — Environment Variables Template
# Copy this file to .env and fill in every value before running docker compose
# NEVER commit .env to git — it contains secrets
# ─────────────────────────────────────────────────────────────────────────────

# ── n8n ───────────────────────────────────────────────────────────────────────
# The public-facing host/URL where n8n is accessible (needed for webhooks)
N8N_HOST=localhost
N8N_PROTOCOL=http
# Full webhook base URL — WAHA will POST inbound messages here
# Example (local with ngrok): https://abc123.ngrok-free.app
# Example (VPS):               https://n8n.yourdomain.com
N8N_WEBHOOK_URL=https://YOUR_NGROK_OR_DOMAIN_URL

# n8n admin UI login
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_strong_password_here

# Random 32-char string to encrypt n8n credentials at rest
# Generate: openssl rand -hex 16
N8N_ENCRYPTION_KEY=CHANGE_ME_32_char_encryption_key_here

# ── WAHA (WhatsApp HTTP API) ──────────────────────────────────────────────────
# API key you set when starting WAHA (protects WAHA's own REST API)
WAHA_API_KEY=CHANGE_ME_waha_api_key_here

# Name of the pilot business's WAHA session (must match businesses.waha_session)
PILOT_WAHA_SESSION=fashion-gallery

# ── Google Gemini API ─────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=CHANGE_ME_your_gemini_api_key_here

# Model IDs (verify current names at aistudio.google.com before building)
GEMINI_CLASSIFIER_MODEL=gemini-2.0-flash-lite
GEMINI_RESPONSE_MODEL=gemini-2.5-pro

# ── Supabase / PostgreSQL ─────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_your_supabase_service_role_key

# Direct Postgres connection (for n8n Postgres node)
# Get from: Supabase Dashboard → Project Settings → Database
SUPABASE_DB_HOST=db.YOUR_PROJECT_REF.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=CHANGE_ME_your_supabase_db_password

# UUID of the pilot demo business (fill in after running seed.sql)
PILOT_BUSINESS_ID=FILL_IN_AFTER_SEED

# ── Brevo (Transactional Email) ───────────────────────────────────────────────
# Get from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=CHANGE_ME_your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Fashion Gallery Assistant

# Business owner contact (receives order & handoff notifications)
OWNER_EMAIL=owner@yourbusiness.com
OWNER_WHATSAPP=94XXXXXXXXX@c.us

# ── Cloudinary (Product Images) ──────────────────────────────────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=CHANGE_ME_your_cloud_name
CLOUDINARY_API_KEY=CHANGE_ME_your_cloudinary_api_key
CLOUDINARY_API_SECRET=CHANGE_ME_your_cloudinary_api_secret

# ── Admin Dashboard (Next.js) ─────────────────────────────────────────────────
# Used by the Next.js 14 dashboard app (dashboard/.env.local)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME_your_supabase_anon_key
NEXTAUTH_SECRET=CHANGE_ME_nextauth_secret_32_chars
NEXTAUTH_URL=http://localhost:3001
